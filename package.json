{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "wrap-unwrap",
  "description": "Wraps and unwraps text",
  "license": "MIT",
  "scripts": {
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "build": "ray build",
    "publish": "npx @raycast/api@latest publish",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1"
  },
  "dependencies": {
    "@raycast/api": "^1.103.0",
    "@raycast/utils": "^2.2.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "icon": "extension-icon.png",
  "commands": [
    {
      "name": "wrap-text",
      "title": "Wrap Text",
      "description": "Wrap text at a index.",
      "mode": "no-view",
      "subtitle": "Wrap Unwrap"
    },
    {
      "name": "unwrap-text",
      "title": "Unwrap Text",
      "description": "Unwrap text.",
      "mode": "no-view",
      "subtitle": "Wrap Unwrap"
    }
  ],
  "title": "Wrap Unwrap",
  "author": "chrismessina",
  "platforms": [
    "Windows",
    "macOS"
  ],
  "categories": [
    "Productivity"
  ]
}